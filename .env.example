IMAGE_HUB_ENV=development
IMAGE_HUB_DATABASE_URL=sqlite:///./data/image-hub.db
IMAGE_HUB_STORAGE_ROOT=./storage
IMAGE_HUB_MAX_ACTIVE_TASKS_PER_USER=5
IMAGE_HUB_MAX_REQUEST_UPLOAD_BYTES=83886080
IMAGE_HUB_MAX_ARTIFACT_BYTES=41943040
# 下面两项必须换成自己的值：服务启动时会检查，占位值会直接拒绝启动。
# Session 密钥是会话 Cookie 的签名根密钥，生成一个：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IMAGE_HUB_SESSION_SECRET=replace-with-a-long-random-secret
IMAGE_HUB_BOOTSTRAP_ADMIN_USERNAME=admin
IMAGE_HUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# LibTV：官方 agent-im skill 的 scripts 目录（需含 create_session.py），以及 Access Key
IMAGE_HUB_LIBTV_SKILL_SCRIPTS=/path/to/libtv-skill/scripts
IMAGE_HUB_LIBTV_ACCESS_KEY=
IMAGE_HUB_LIBTV_IM_BASE=https://im.liblib.tv
# Lovart：官方 lovart-api skill 的适配脚本路径，以及 AK/SK
IMAGE_HUB_LOVART_ACCESS_KEY=
IMAGE_HUB_LOVART_SECRET_KEY=
IMAGE_HUB_LOVART_BASE_URL=https://lgw.lovart.ai
IMAGE_HUB_LOVART_SKILL_SCRIPT=/path/to/lovart-api/scripts/agent_skill.py
IMAGE_HUB_LOVART_THREAD_MODE=fast
IMAGE_HUB_LOVART_CHAT_TIMEOUT_SECONDS=1800
IMAGE_HUB_OPENAI_IMAGE_API_KEY=
IMAGE_HUB_OPENAI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_HUB_OPENAI_IMAGE_MODELS=doubao-seedream-5-0-pro-260628|Seedream 5.0 Pro
IMAGE_HUB_WORKER_ENABLED=true
IMAGE_HUB_WORKER_POLL_SECONDS=1
IMAGE_HUB_WORKER_STALE_MINUTES=60
# 待恢复任务的自动复查：间隔秒数与次数上限。上游生图要几分钟，探针每次只查
# 一次就返回，靠 worker 按这个节奏把任务捞回来推进；默认覆盖约 10 分钟。
IMAGE_HUB_WORKER_RECONCILE_SECONDS=15
IMAGE_HUB_WORKER_RECONCILE_MAX_ATTEMPTS=40
IMAGE_HUB_PROVIDER_COMMAND_TIMEOUT_SECONDS=900
# 同时执行的生成任务数（平台承载力的唯一旋钮）：每个槽位一个线程，一次一个任务。
# 生图受上游延迟支配、本地几乎不吃 CPU，所以槽位可以明显多于 CPU 核数。
IMAGE_HUB_WORKER_CONCURRENCY=4
# API 通道回复方式：async（提交拿 task id 再轮询 /api/result）/ sync（一次请求阻塞到出图）。
# 两条路径都已用真实上游跑通出图；async 少押住连接、过载重提更廉价。
IMAGE_HUB_API_REPLY_MODE=async
# 异步轮询间隔（秒）
IMAGE_HUB_API_POLL_SECONDS=3
# 异步轮询总时长上限（秒）
IMAGE_HUB_API_POLL_TIMEOUT_SECONDS=600
# 上游瞬时故障（过载）的重试次数（不含首次，总尝试 = 1 + 此值）
IMAGE_HUB_API_SUBMIT_RETRIES=3
# 重试退避基数（秒）：第 n 次退避 = backoff * n
IMAGE_HUB_API_RETRY_BACKOFF_SECONDS=5
